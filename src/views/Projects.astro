---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCell from '../components/ProjectCell.astro';
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { projects, common } = getDictionary(lang);
---

<Base lang={lang} page="projects">
  <PageHeader label={projects.sheet} title={projects.title} />

  <section class="container section">
    {
      projects.items.length > 0 ? (
        <ul class="projects-grid">
          {projects.items.map((project) => (
            <li>
              <ProjectCell project={project} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="projects-empty">
          <span class="label projects-empty__label">{common.comingSoon}</span>
          <p class="projects-empty__text">{projects.empty}</p>
        </div>
      )
    }
  </section>
</Base>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 2px;
    padding: 0;
    list-style: none;
  }

  .projects-empty {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7) 0;
    border-top: var(--border-rule) solid var(--ven-blue);
    border-bottom: var(--border-hairline) solid var(--blue-200);
  }

  .projects-empty__label {
    color: var(--blue-500);
  }

  .projects-empty__text {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
  }
</style>
