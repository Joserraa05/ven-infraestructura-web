---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getDictionary, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { services } = getDictionary(lang);
const disciplines = [
  { id: 'electric', ...services.electric },
  { id: 'civil', ...services.civil },
];
---

<Base lang={lang} page="services">
  <PageHeader label={services.sheet} title={services.title} />

  {
    disciplines.map((discipline) => (
      <section class="container discipline" aria-labelledby={`${discipline.id}-title`}>
        <SectionHeader id={`${discipline.id}-title`} title={discipline.title} label={discipline.label} />
        <ul class="discipline__services">
          {discipline.items.map((service) => (
            <li class="service-card">
              <span class="service-card__mark" aria-hidden="true" />
              <h3 class="service-card__title">{service.title}</h3>
              <dl class="service-card__details">
                <div>
                  <dt class="label">{services.descriptionLabel}</dt>
                  <dd>{service.description}</dd>
                </div>
                <div>
                  <dt class="label">{services.scopeLabel}</dt>
                  <dd>{service.scope}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .discipline {
    padding-block: var(--space-9) 0;
  }

  .discipline:last-of-type {
    padding-bottom: var(--space-9);
  }

  .discipline__services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    padding: 0;
    list-style: none;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5) var(--space-6) 0;
    border-bottom: var(--border-hairline) solid var(--blue-200);
    transition: background-color var(--dur-fast) var(--ease-out-ven);
  }

  .service-card:hover {
    background: var(--blue-25);
  }

  .service-card__mark {
    width: var(--space-3);
    height: var(--space-3);
    background: var(--signal-yellow);
    transition: width var(--dur-fast) var(--ease-out-ven);
  }

  .service-card:hover .service-card__mark {
    width: 48px;
  }

  .service-card__title {
    font-size: var(--fs-h4);
    color: var(--ven-blue);
  }

  .service-card__details {
    display: grid;
    gap: var(--space-3);
  }

  .service-card__details div {
    padding-top: var(--space-3);
    border-top: var(--border-hairline) solid var(--blue-50);
  }

  .service-card__details dt {
    color: var(--blue-500);
  }

  .service-card__details dd {
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }
</style>
