---
import { getPath, t, type Lang, type PageId } from '../i18n/utils';
import LanguageSwitch from './LanguageSwitch.astro';
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;

const navItems = [
  { label: t(lang, 'nav.services'), href: getPath(lang, 'services'), current: page === 'services' },
  { label: t(lang, 'nav.team'), href: getPath(lang, 'home', 'team'), current: false },
  { label: t(lang, 'nav.clients'), href: getPath(lang, 'home', 'clients'), current: false },
  { label: t(lang, 'nav.contact'), href: getPath(lang, 'contact'), current: page === 'contact' },
];
---

<header class="site-header on-blue">
  <div class="container site-header__bar">
    <a class="site-header__home" href={getPath(lang, 'home')} aria-label={t(lang, 'nav.home')}>
      <Logo eager />
    </a>

    <nav class="site-header__nav" aria-label={t(lang, 'nav.main')}>
      <ul class="site-header__links">
        {
          navItems.map((item) => (
            <li>
              <a class="link" href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__language">
      <LanguageSwitch lang={lang} page={page} variant="compact" />
    </div>

    <MobileMenu lang={lang} page={page} items={navItems} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ven-blue);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-height);
    padding-block: var(--space-5);
  }

  .site-header__home {
    display: block;
    flex: none;
  }

  .site-header__nav,
  .site-header__language {
    display: none;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
    font-size: var(--fs-nav);
    font-weight: var(--fw-head);
  }

  /* Desktop: equal side columns keep the menu centred on the page, not between logo and language. */
  @media (min-width: 860px) {
    .site-header__bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__home {
      justify-self: start;
    }

    .site-header__nav {
      display: block;
    }

    .site-header__language {
      display: block;
      justify-self: end;
    }
  }
</style>
