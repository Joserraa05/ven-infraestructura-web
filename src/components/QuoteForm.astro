---
import { FORM_ENDPOINT } from '../config';
import { getDictionary, getPath, type Lang } from '../i18n/utils';
import Chevron from './Chevron.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { form } = getDictionary(lang);
const defaultCountry = lang === 'pt' ? 'PT' : 'ES';

const textFields = [
  { name: 'name', label: form.name, type: 'text', autocomplete: 'name', required: true },
  { name: 'company', label: form.company, type: 'text', autocomplete: 'organization', required: false },
  { name: 'email', label: form.email, type: 'email', autocomplete: 'email', required: true },
  { name: 'phone', label: form.phone, type: 'tel', autocomplete: 'tel', required: false },
] as const;

const countries = [
  { value: 'ES', label: form.countryES },
  { value: 'PT', label: form.countryPT },
  { value: 'both', label: form.countryBoth },
];

const serviceTypes = [
  { value: 'electric', label: form.serviceElectric },
  { value: 'civil', label: form.serviceCivil },
  { value: 'both', label: form.serviceBoth },
  { value: 'other', label: form.serviceOther },
];
---

<form
  class="quote-form"
  action={FORM_ENDPOINT}
  method="post"
  data-quote-form
  data-message-required={form.required}
  data-message-email={form.invalidEmail}
  data-message-sending={form.sending}
  data-message-success={form.success}
  data-message-error={form.error}
>
  <div class="quote-form__grid">
    {
      textFields.map((field) => (
        <div class="field">
          <label class="field__label" for={`quote-${field.name}`}>
            {field.label}
            {!field.required && <span class="field__optional">({form.optional})</span>}
          </label>
          <input
            class="field__control"
            id={`quote-${field.name}`}
            name={field.name}
            type={field.type}
            autocomplete={field.autocomplete}
            required={field.required}
            aria-describedby={`quote-${field.name}-error`}
          />
          <p class="field__error" id={`quote-${field.name}-error`} />
        </div>
      ))
    }

    <div class="field">
      <label class="field__label" for="quote-country">{form.country}</label>
      <div class="select">
        <select class="field__control" id="quote-country" name="country" required aria-describedby="quote-country-error">
          {
            countries.map((country) => (
              <option value={country.value} selected={country.value === defaultCountry}>
                {country.label}
              </option>
            ))
          }
        </select>
      </div>
      <p class="field__error" id="quote-country-error"></p>
    </div>

    <div class="field">
      <label class="field__label" for="quote-service">{form.service}</label>
      <div class="select">
        <select class="field__control" id="quote-service" name="service" required aria-describedby="quote-service-error">
          <option value="" selected disabled>{form.choose}</option>
          {serviceTypes.map((service) => <option value={service.value}>{service.label}</option>)}
        </select>
      </div>
      <p class="field__error" id="quote-service-error"></p>
    </div>

    <div class="field field--wide">
      <label class="field__label" for="quote-message">{form.message}</label>
      <textarea class="field__control" id="quote-message" name="message" rows="6" required aria-describedby="quote-message-error"></textarea>
      <p class="field__error" id="quote-message-error"></p>
    </div>

    <div class="field field--wide">
      <div class="checkbox">
        <input class="checkbox__control" id="quote-privacy" name="privacy" type="checkbox" value="accepted" required aria-describedby="quote-privacy-error" />
        <label for="quote-privacy">
          {form.privacyPrefix} <a href={getPath(lang, 'privacy')}>{form.privacyLink}</a>
        </label>
      </div>
      <p class="field__error" id="quote-privacy-error"></p>
    </div>
  </div>

  <div class="quote-form__actions">
    <button class="button button--primary" type="submit">
      <span data-submit-label>{form.submit}</span>
      <Chevron />
    </button>
    <p class="quote-form__status" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>

<style>
  .quote-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .quote-form__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-5) var(--space-6);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  .field__label {
    font-weight: var(--fw-head);
    color: var(--ven-blue);
  }

  .field__optional {
    margin-left: var(--space-2);
    font-weight: var(--fw-text);
    color: var(--blue-500);
  }

  .field__control {
    width: 100%;
    min-height: var(--button-height);
    padding: var(--space-3) var(--space-4);
    border: var(--border-hairline) solid var(--blue-200);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ven-navy);
    transition: border-color var(--dur-fast) var(--ease-out-ven);
  }

  .field__control:hover,
  .field__control:focus-visible {
    border-color: var(--ven-blue);
  }

  /* Single-line controls share one height; native select styling would otherwise size them differently. */
  input.field__control,
  select.field__control {
    height: var(--button-height);
  }

  textarea.field__control {
    resize: vertical;
  }

  .select {
    --select-arrow-size: 8px;

    position: relative;
  }

  .select select {
    appearance: none;
    padding-right: calc(var(--space-4) * 2 + var(--select-arrow-size));
    line-height: 1.2;
    cursor: pointer;
  }

  /* Down chevron drawn with two 2px strokes, matching the brand's square-cap icons. */
  .select::after {
    content: '';
    position: absolute;
    right: var(--space-4);
    top: 50%;
    width: var(--select-arrow-size);
    height: var(--select-arrow-size);
    border-right: var(--border-rule) solid var(--ven-blue);
    border-bottom: var(--border-rule) solid var(--ven-blue);
    transform: translateY(-75%) rotate(45deg);
    pointer-events: none;
  }

  .field__control[aria-invalid='true'] {
    border-color: var(--ven-navy);
    border-width: var(--border-rule);
  }

  .field__error {
    min-height: 1.5em;
    font-size: var(--fs-nav);
    color: var(--ven-navy);
  }

  .field__error:not(:empty)::before {
    content: '';
    display: inline-block;
    width: var(--space-2);
    height: var(--space-2);
    margin-right: var(--space-2);
    background: var(--signal-yellow);
    vertical-align: middle;
  }

  .checkbox {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .checkbox__control {
    flex: none;
    width: var(--space-5);
    height: var(--space-5);
    margin: 0;
    border-radius: var(--radius);
    accent-color: var(--ven-blue);
  }

  .checkbox label {
    color: var(--ink-soft);
  }

  .checkbox a {
    color: var(--ven-blue);
    font-weight: var(--fw-head);
  }

  .quote-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .quote-form__status {
    font-weight: var(--fw-head);
    color: var(--ven-blue);
  }
</style>

<script>
  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  function setUpQuoteForm(form: HTMLFormElement) {
    const messages = form.dataset;
    const controls = [...form.querySelectorAll<Control>('input, select, textarea')];
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const idleLabel = submitLabel?.textContent ?? '';

    function errorFor(control: Control): string {
      if (control.validity.valueMissing) return messages.messageRequired ?? '';
      if (control.validity.typeMismatch) return messages.messageEmail ?? '';
      return '';
    }

    function showError(control: Control, message: string) {
      const errorElement = document.getElementById(`${control.id}-error`);
      if (errorElement) errorElement.textContent = message;
      control.setAttribute('aria-invalid', String(message !== ''));
    }

    controls.forEach((control) => {
      // Native validation stays in charge; only the bubble text comes from the dictionaries.
      control.addEventListener('invalid', () => {
        const message = errorFor(control);
        control.setCustomValidity(message);
        showError(control, message);
      });
      const revalidate = () => {
        control.setCustomValidity('');
        if (control.getAttribute('aria-invalid') === 'true') {
          showError(control, control.checkValidity() ? '' : errorFor(control));
        }
      };
      control.addEventListener('input', revalidate);
      control.addEventListener('change', revalidate);
    });

    function setSending(isSending: boolean) {
      if (submitButton) submitButton.disabled = isSending;
      if (submitLabel) submitLabel.textContent = isSending ? (messages.messageSending ?? idleLabel) : idleLabel;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (status) status.textContent = '';

      const endpoint = form.getAttribute('action');
      if (!endpoint) {
        if (status) status.textContent = messages.messageError ?? '';
        return;
      }

      setSending(true);
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Form endpoint answered ${response.status}`);
        form.reset();
        if (status) status.textContent = messages.messageSuccess ?? '';
      } catch (error) {
        console.error('Quote form submission failed', error);
        if (status) status.textContent = messages.messageError ?? '';
      } finally {
        setSending(false);
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach(setUpQuoteForm);
</script>
